{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "maxDuration": 60
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/main.py" },
    { "src": "/static/(.*)", "dest": "/frontend/$1" },
    { "src": "^/$", "dest": "/frontend/index.html" },
    { "src": "/(.*\\.html)", "dest": "/frontend/$1" },
    { "src": "/(.*\\.png|.*\\.jpg|.*\\.svg|.*\\.ico)", "dest": "/frontend/$1" }
  ]
}
