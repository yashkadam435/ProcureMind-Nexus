# ===========================================
# ProcureMind Nexus — Environment Variables
# ===========================================
# Copy this file to .env and fill in your API keys
# NEVER commit .env with real keys to git
# ===========================================

# Gemini (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRO=gemini-2.5-pro-preview-05-06
GEMINI_MODEL_FLASH=gemini-2.5-flash-preview-05-20

# Database (SQLite — auto-created, no config needed)
# DATABASE_URL=sqlite:///backend/procuremind.db

# x402 / Coinbase (Optional — for blockchain payments)
COINBASE_API_KEY=
X402_WALLET_PRIVATE_KEY=
X402_FACILITATOR_URL=https://facilitator.x402.org
BASE_RPC_URL=https://mainnet.base.org

# Speechmatics (Optional — for voice queries)
SPEECHMATICS_API_KEY=
SPEECHMATICS_WS_URL=wss://eu2.rt.speechmatics.com/v2

# Kraken (Optional — for xStocks paper trading)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Vultr (Optional — for deployment)
VULTR_API_KEY=
VULTR_INFERENCE_ENDPOINT=

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
HUMAN_APPROVAL_THRESHOLD_EUR=10000
